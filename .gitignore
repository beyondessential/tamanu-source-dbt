# IDE and editor files
# Track .claude/ (settings.json, hooks/, commands/, skills/, agents/) so team-shared
# Claude config is version-controlled; keep only per-developer files local.
.claude/settings.local.json
CLAUDE.md
.idea
.vscode

# OS files
.DS_Store

# Environment and config
.env
.user.yml
local_config/

# Python
__pycache__
*.egg-info/

# Dependencies
dbt_packages/
package-lock.yml
uv.lock

# Build and generated files
compiled/*/*.json
# ...but the report catalogue's JSON is half of a published artifact pair, so it is
# tracked: a plain `git add` must not commit the .html and drop the .json beside it.
!compiled/*/report-catalogue-*.json
/logs/
macros/default_translations.sql
models/surveys/
target/
.temp/
