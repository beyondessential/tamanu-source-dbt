# Generated output and vendored package code, never source -- the same scope
# dbt-conventions.md's "Do not review" list already excludes from human review.
# target/ crashes sqlfluff outright on Windows (a compiled unit-test's path is
# mis-resolved); compiled/ and dbt_packages/ only produce noisy warnings, but
# there's nothing in either worth linting either way.
target/
compiled/
dbt_packages/

# IS DISTINCT FROM in CASE WHEN causes SQLFluff PRS errors (known parser limitation).
# The underlying SQL is valid PostgreSQL. The change-evaluation logic lives in both the
# report and dataset macros, so all four compiled models hit it.
models/reports/sql/standard/audit-outpatient-appointments.sql
models/reports/sql/sensitive/sensitive-audit-outpatient-appointments.sql
models/datasets/standard/ds__outpatient_appointments_audit.sql
models/datasets/sensitive/ds__sensitive_outpatient_appointments_audit.sql

# The compiled encounter_summary report exceeds sqlfluff's sqlparse token limit
# (10000) and crashes during parsing. The underlying SQL runs fine under dbt;
# this is a sqlfluff/sqlparse limitation, not a defect in the model. The
# by-start-date variants crossed the same limit once the encounterTypeGroup
# filter (MAUI-7063) added history_in_scope and encounter_type_groups.
models/reports/sql/standard/encounter-summary-by-end-date.sql
models/reports/sql/sensitive/sensitive-encounter-summary-by-end-date.sql
models/reports/sql/standard/encounter-summary-by-start-date.sql
models/reports/sql/sensitive/sensitive-encounter-summary-by-start-date.sql

# These ref() invoice_price_lists, and sqlfluff's dbt templater actually
# executes against the connected database at this point in compilation
# (unlike a plain ref(), which only resolves an identifier) -- it needs the
# real relation to exist, not just a reachable database. Not coverable by
# make db-up's schema-less local Postgres; needs either real credentials or
# the schema-only seeding WP1 is meant to add.
models/reports/sql/standard/invoice-products-summary.sql
models/datasets/standard/ds__invoice_products.sql
