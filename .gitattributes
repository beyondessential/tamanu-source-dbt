# Auto detect text files and normalise to LF, in the repo and the working copy: a CRLF
# checkout leaks CRs into the compiled bundle and makes release diffs churn
* text=auto eol=lf

# Shell scripts must always use LF, even in a Windows working copy, or bash breaks
*.sh text eol=lf

# Compiled dbt bundle artifacts are committed intentionally (version-bump commits)
# but shouldn't clutter local diffs or PR reviews.
compiled/** -diff linguist-generated=true
