# Fake values for the disposable Postgres that `make db-up` starts (see .maui/templates/dbt.mk).
# Nothing here is a secret and nothing reaches a real database. `make check` reads this file when
# there is no .env, which lets sqlfluff, the dbt unit tests and the report validators run without
# credentials. Real credentials stay in secret-sources.ini, loaded by `make check-data`.
DBT_PROFILES_DIR=config

TAMANU_RL_DB_URL=localhost
TAMANU_RL_DB_PORT=55432
TAMANU_RL_DB_USER=maui
TAMANU_RL_DB_PASSWORD=maui
TAMANU_RL_DB_DATABASE=maui

TAMANU_DEMO_DB_URL=localhost
TAMANU_DEMO_DB_PORT=55432
TAMANU_DEMO_DB_USER=maui
TAMANU_DEMO_DB_PASSWORD=maui
TAMANU_DEMO_DB_DATABASE=maui
