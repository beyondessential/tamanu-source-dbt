# Tamanu DBT Environment Variables
# Copy this file to .env and fill in your actual values

# Demo Database Connection
TAMANU_DEMO_DB_URL=your_demo_host_here
TAMANU_DEMO_DB_USER=your_demo_user_here
TAMANU_DEMO_DB_PASSWORD=your_demo_password_here
TAMANU_DEMO_DB_DATABASE=your_demo_database_here

# Release Database Connection
TAMANU_RL_DB_URL=your_release_host_here
TAMANU_RL_DB_PORT=5432
TAMANU_RL_DB_USER=your_release_user_here
TAMANU_RL_DB_PASSWORD=your_release_password_here
TAMANU_RL_DB_DATABASE=your_release_database_here
