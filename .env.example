# Tamanu DBT Environment Variables
# Names only. Don't copy this to .env: run commands through the secrets runner, which loads each
# value from the source named in secret-sources.ini when the command runs (see README § Local
# development):
#   uv run python .maui/scripts/with_secrets.py -- <cmd>

# dbt configuration: [env] in secret-sources.ini. Points dbt at config/profiles.yml without a
# --profiles-dir flag.
DBT_PROFILES_DIR=config

# Demo database (reporting_demo target): Bitwarden note tamanu-source-dbt.env
TAMANU_DEMO_DB_URL=
TAMANU_DEMO_DB_USER=
TAMANU_DEMO_DB_PASSWORD=
TAMANU_DEMO_DB_DATABASE=

# Release database (reporting_release and analytics targets): this branch's release server on
# the main Kubernetes cluster ([releases] in secret-sources.ini)
TAMANU_RL_DB_URL=
TAMANU_RL_DB_PORT=
TAMANU_RL_DB_USER=
TAMANU_RL_DB_PASSWORD=
TAMANU_RL_DB_DATABASE=
