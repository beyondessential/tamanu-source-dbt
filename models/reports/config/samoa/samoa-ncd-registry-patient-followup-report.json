{
  "query": "replace this",
  "name": "DM & HTN patient follow up",
  "notes": "DM & HTN patient follow up - v2.19 \nThis report will show those on the NCD registry and their vitals from the previous 2 visits to a facility. This will help follow up patients who do not have their diabetes or hypertension under control.",
  "status": "published",
  "dbSchema": "raw",
  "queryOptions": {
    "defaultDateRange": "allTime",
    "dateRangeLabel": "Date range (or leave blank for all active admissions)",
    "dataSources": ["thisFacility", "allFacilities"],
    "parameters": [
      {
        "parameterField": "ParameterAutocompleteField",
        "name": "facilityId",
        "label": "Registering facility",
        "suggesterEndpoint": "facility"
      },
      {
        "parameterField": "ParameterAutocompleteField",
        "label": "Village",
        "name": "villageId",
        "suggesterEndpoint": "village"
      },
      {
        "parameterField": "ParameterSelectField",
        "label": "Sex",
        "name": "sex",
        "options": [
          {
            "label": "Male",
            "value": "male"
          },
          {
            "label": "Female",
            "value": "female"
          }
        ]
      },
      {
        "parameterField": "ParameterSelectField",
        "label": "Related conditions",
        "name": "conditionId",
        "options": [
          {
            "label": "Hypertension",
            "value": "prCondition-samoancdregistry-hypertension"
          },
          {
            "label": "Type 1 Diabetes",
            "value": "prCondition-samoancdregistry-type1diabetes"
          },
          {
            "label": "Type 2 Diabetes",
            "value": "prCondition-samoancdregistry-type2diabetes"
          }
        ]
      },
      {
        "parameterField": "ParameterAutocompleteField",
        "label": "Status",
        "name": "statusId",
        "suggesterEndpoint": "programRegistryClinicalStatus",
        "suggesterOptions": {
          "baseQueryParameters": {
            "programRegistryId": "programRegistry-samoancdregistry"
          }
        }
      }
    ]
  }
}
