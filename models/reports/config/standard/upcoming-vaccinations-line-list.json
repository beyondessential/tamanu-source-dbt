{
  "query": "replace this",
  "name": "Upcoming vaccinations line list",
  "status": "published",
  "notes": "This report generates upcoming vaccination schedules for patients up to 18 years old by default or for patients born within the user-selected date range.",
  "dbSchema": "reporting",
  "queryOptions": {
    "defaultDateRange": "18years",
    "dateRangeLabel": "Enter dates or leave blank for births in the past 18 years",
    "dataSources": [
      "thisFacility",
      "allFacilities"
    ],
    "parameters": [
      {
        "parameterField": "VaccineCategoryField",
        "label": "Category",
        "name": "category"
      },
      {
        "parameterField": "VaccineField",
        "label": "Vaccine",
        "name": "vaccine"
      },
      {
        "parameterField": "ParameterSelectField",
        "label": "Vaccine status",
        "name": "status",
        "options": [
          {
            "label": "Missed",
            "value": "MISSED"
          },
          {
            "label": "Overdue",
            "value": "OVERDUE"
          },
          {
            "label": "Due",
            "value": "DUE"
          },
          {
            "label": "Upcoming",
            "value": "UPCOMING"
          },
          {
            "label": "Scheduled",
            "value": "SCHEDULED"
          }
        ]
      },
      {
        "parameterField": "ParameterAutocompleteField",
        "label": "Village",
        "name": "villageId",
        "suggesterEndpoint": "village"
      }
    ]
  }
}
