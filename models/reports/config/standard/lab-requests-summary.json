{
  "query": "replace this",
  "name": "Lab requests summary",
  "status": "published",
  "notes": "This report provides a statistical summary of lab requests by date, department and lab test category.",
  "dbSchema": "reporting",
  "queryOptions": {
    "defaultDateRange": "allTime",
    "dataSources": [
      "thisFacility",
      "allFacilities"
    ],
    "parameters": [
      {
        "parameterField": "FacilityField",
        "label": "Facility",
        "name": "facilityId",
        "filterBySelectedFacility": true
      },
      {
        "parameterField": "ParameterAutocompleteField",
        "label": "Department",
        "name": "departmentId",
        "suggesterEndpoint": "department",
        "suggesterOptions": {
          "baseQueryParameters": {
            "filterByFacility": true
          }
        }
      },
      {
        "parameterField": "ParameterAutocompleteField",
        "label": "Category",
        "name": "labTestCategoryId",
        "suggesterEndpoint": "labTestCategory"
      }
    ]
  }
}
