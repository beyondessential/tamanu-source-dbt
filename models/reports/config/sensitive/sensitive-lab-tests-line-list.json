{
  "query": "replace this",
  "name": "Sensitive lab tests line list",
  "status": "published",
  "notes": "This report generates a list of all patients that have had a lab test performed at a sensitive facility for the selected parameters. Patients are listed in chronological order based on the lab request date and time. All lab tests performed at a sensitive facility are included in this report, regardless of whether the individual lab test itself is marked as sensitive.\n\nThe report includes detailed test results, verification status, and completion information.",
  "dbSchema": "reporting",
  "queryOptions": {
    "defaultDateRange": "7days",
    "dataSources": [
      "thisFacility",
      "allFacilities"
    ],
    "parameters": [
      {
        "parameterField": "ParameterSelectField",
        "label": "Status",
        "name": "statusId",
        "options": [
          {
            "label": "Reception pending",
            "value": "reception_pending"
          },
          {
            "label": "Results pending",
            "value": "results_pending"
          },
          {
            "label": "To be verified",
            "value": "to_be_verified"
          },
          {
            "label": "Verified",
            "value": "verified"
          },
          {
            "label": "Published",
            "value": "published"
          },
          {
            "label": "Cancelled",
            "value": "cancelled"
          },
          {
            "label": "Deleted",
            "value": "deleted"
          },
          {
            "label": "Sample not collected",
            "value": "sample-not-collected"
          },
          {
            "label": "Entered in error",
            "value": "entered-in-error"
          }
        ]
      },
      {
        "parameterField": "LabTestCategorySensitiveField",
        "label": "Test category",
        "name": "testCategoryId"
      }
    ]
  }
}
