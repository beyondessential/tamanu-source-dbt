{
  "query": "replace this",
  "name": "Sensitive location bookings line list",
  "notes": "This report generates a list of all location bookings at sensitive facilities for the selected parameters. Patients are listed in chronological order by date and time of booking",
  "status": "published",
  "dbSchema": "reporting",
  "queryOptions": {
    "defaultDateRange": "next30days",
    "dataSources": ["thisFacility", "allFacilities"],
    "parameters": [
      {
        "parameterField": "FacilityField",
        "label": "Facility",
        "name": "facilityId",
        "filterBySelectedFacility": true
      },
      {
        "parameterField": "ParameterAutocompleteField",
        "label": "Area",
        "name": "locationGroupId",
        "suggesterEndpoint": "locationGroup",
        "suggesterOptions": {
          "baseQueryParameters": {
            "filterByFacility": true
          }
        }
      },
      {
        "parameterField": "ParameterAutocompleteField",
        "label": "Clinician",
        "name": "clinicianId",
        "suggesterEndpoint": "practitioner"
      },
      {
        "parameterField": "BookingTypeField",
        "label": "Booking type",
        "name": "bookingTypeId"
      },
      {
        "parameterField": "ParameterSelectField",
        "label": "Status",
        "name": "bookingStatus",
        "options": [
          {
            "label": "Confirmed",
            "value": "Confirmed"
          },
          {
            "label": "Arrived",
            "value": "Arrived"
          },
          {
            "label": "Assessed",
            "value": "Assessed"
          },
          {
            "label": "Seen",
            "value": "Seen"
          },
          {
            "label": "No show",
            "value": "No-show"
          },
          {
            "label": "Cancelled",
            "value": "Cancelled"
          }
        ]
      }
    ]
  }
}
