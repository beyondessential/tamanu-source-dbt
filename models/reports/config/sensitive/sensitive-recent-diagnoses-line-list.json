{
  "query": "replace this",
  "name": "Sensitive recent diagnoses line list",
  "status": "published",
  "notes": "This report lists all patients that have had any of the selected diagnoses recorded at sensitive facilities (all diagnoses when none are selected). Diagnoses with a certainty of 'Confirmed', 'Suspected', or 'Emergency' are included. Diagnoses with a certainty of 'Disproven' or 'Recorded in error' are excluded.",
  "dbSchema": "reporting",
  "queryOptions": {
    "defaultDateRange": "24hours",
    "dataSources": [
      "thisFacility",
      "allFacilities"
    ],
    "parameters": [
      {
        "parameterField": "FacilityField",
        "label": "Facility",
        "name": "facilityId",
        "filterBySelectedFacility": true
      },
      {
        "parameterField": "VillageField",
        "label": "Village",
        "name": "villageId"
      },
      {
        "parameterField": "ParameterSuggesterSelectField",
        "label": "Diagnosis",
        "name": "diagnosisId",
        "suggesterEndpoint": "diagnosis",
        "isMulti": true
      },
      {
        "parameterField": "ParameterAutocompleteField",
        "label": "Clinician",
        "name": "clinicianId",
        "suggesterEndpoint": "practitioner"
      }
    ]
  }
}
