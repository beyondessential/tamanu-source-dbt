{
  "query": "replace this",
  "name": "Sensitive medication dispensed summary",
  "status": "published",
  "notes": "This report shows quantity of medication dispensed for a given drug within a specified date range for dispense records from sensitive facilities, based on dispense records.",
  "dbSchema": "reporting",
  "queryOptions": {
    "defaultDateRange": "30days",
    "dataSources": [
      "thisFacility",
      "allFacilities"
    ],
    "parameters": [
      {
        "parameterField": "FacilityField",
        "label": "Facility",
        "name": "facilityId",
        "filterBySelectedFacility": true
      },
      {
        "parameterField": "ParameterAutocompleteField",
        "label": "Drug",
        "name": "medicationId",
        "suggesterEndpoint": "drug"
      }
    ]
  }
}
