{
  "query": "replace this",
  "name": "Sensitive lab tests line list",
  "notes": "This report generates a list of all patients that have had sensitive lab tests performed for the selected parameters. Patients are listed in chronological order based on the lab request date and time. Only lab tests marked as sensitive in the system are included in this report.\n\nThe report includes detailed test results, verification status, and completion information for sensitive tests only.",
  "status": "published",
  "dbSchema": "reporting",
  "queryOptions": {
    "defaultDateRange": "7days",
    "dataSources": ["thisFacility", "allFacilities"],
    "parameters": [
      {
        "parameterField": "ParameterSelectField",
        "label": "Status",
        "name": "statusId",
        "options": [
          {
            "label": "Reception pending",
            "value": "reception_pending"
          },
          {
            "label": "Results pending",
            "value": "results_pending"
          },
          {
            "label": "To be verified",
            "value": "to_be_verified"
          },
          {
            "label": "Verified",
            "value": "verified"
          },
          {
            "label": "Published",
            "value": "published"
          },
          {
            "label": "Cancelled",
            "value": "cancelled"
          },
          {
            "label": "Deleted",
            "value": "deleted"
          },
          {
            "label": "Sample not collected",
            "value": "sample-not-collected"
          },
          {
            "label": "Entered in error",
            "value": "entered-in-error"
          }
        ]
      },
      {
        "parameterField": "LabTestCategorySensitiveField",
        "label": "Test category",
        "name": "testCategoryId"
      }
    ]
  }
