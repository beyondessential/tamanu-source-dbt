{
  "extraKnownMarketplaces": {
    "bes": {
      "source": {
        "source": "github",
        "repo": "beyondessential/claude-plugins"
      }
    }
  },
  "enabledPlugins": {
    "tamanu@bes": true,
    "bes-skills@bes": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path'); case \"$f\" in *.sql) sqlfluff lint \"$f\" || true;; esac; grep -lU $'\\r' \"$f\" && echo 'WARNING: CRLF line endings in '$f"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*linear.*__(create|update|save).*",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"decision\":\"ask\",\"reason\":\"Linear write requires user approval\"}'"
          }
        ]
      }
    ]
  }
}
