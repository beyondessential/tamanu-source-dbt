{
  "extraKnownMarketplaces": {
    "bes": {
      "source": {
        "source": "github",
        "repo": "beyondessential/claude-plugins"
      }
    }
  },
  "enabledPlugins": {
    "tamanu@bes": true,
    "bes-skills@bes": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(grep -o '\"file_path\" *: *\"[^\"]*\"' | head -n 1 | sed -e 's/^\"file_path\" *: *\"//' -e 's/\"$//' -e 's#[\\]#/#g' -e 's#//*#/#g'); [ -f \"$f\" ] || exit 0; case \"$f\" in *.sql) sqlfluff lint \"$f\" || true;; esac; if grep -qU \"$(printf '\\r')\" \"$f\"; then echo \"CRLF line endings in $f: convert it to LF\" >&2; exit 2; fi"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*linear.*__(create|update|save).*",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"ask\",\"permissionDecisionReason\":\"Linear write requires user approval\"}}'"
          }
        ]
      }
    ]
  }
}
