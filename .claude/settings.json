{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "maui-team": {
      "source": {
        "source": "directory",
        "path": "./.maui"
      }
    }
  },
  "enabledPlugins": {
    "maui-tamanu@maui-team": true,
    "maui-internal@maui-team": true,
    "maui-core@maui-team": true
  }
}
